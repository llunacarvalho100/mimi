# ==============================================================================
# VARIÁVEIS DE AMBIENTE - PINTWEET ENTERPRISE (VERCEL & PRODUÇÃO)
# Adicione estas chaves no painel da Vercel: Settings > Environment Variables
# ==============================================================================

# 1. BANCO DE DADOS: SUPABASE (PostgreSQL na Nuvem para persistência definitiva)
# Obtenha no painel do Supabase: Project Settings > API
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY="sua_chave_anon_publica_aqui"
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_secreta_aqui"

# Opcional (se desejar conexão direta com o PostgreSQL da Supabase/Neon/CloudSQL):
DATABASE_URL="postgresql://postgres:suasenha@db.seu-projeto.supabase.co:5432/postgres"

# 2. AUTENTICAÇÃO: GOOGLE OAUTH 2.0 (Google SSO)
# Obtenha no Google Cloud Console: APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="seu-cliente-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-segredo-de-cliente-aqui"
VITE_GOOGLE_CLIENT_ID="seu-cliente-id.apps.googleusercontent.com"

# 3. SEGURANÇA & SESSÃO (Criptografia de Tokens e Hashing)
SESSION_SECRET="uma_chave_secreta_longa_e_aleatoria_para_assinatura_de_tokens"

# 4. AMBIENTE & URLS (Configurados pela Vercel / Cloud Run)
NODE_ENV="production"
APP_URL="https://seu-projeto.vercel.app"

# GEMINI_API_KEY (Caso ative recursos do Google Gemini)
GEMINI_API_KEY="sua_chave_gemini_aqui"
